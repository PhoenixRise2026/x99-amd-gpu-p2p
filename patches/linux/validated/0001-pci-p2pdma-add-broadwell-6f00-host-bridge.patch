From 78d7d3da9419bebf9c91d65c6268db56a705445e Mon Sep 17 00:00:00 2001
From: Open Source Contributor <contributor@example.org>
Date: Mon, 14 Sep 2026 02:30:00 +0000
Subject: [PATCH] PCI/P2PDMA: add Intel Broadwell-EP 0x6f00 host bridge to whitelist

Add device ID 0x6f00 (Intel Xeon E7 v4 / Xeon E5 v4 DMI2 Host Bridge)
to pci_p2pdma_whitelist[] with REQ_SAME_HOST_BRIDGE.

Tested on Intel Xeon E5-2697A v4 (single socket) with dual AMD Radeon
AI PRO R9700 GPUs connected to Root Ports 00:02.0 and 00:03.0.
Peer-to-peer DMA verified with ~10.29 GB/s per-direction throughput
and zero hardware or bus errors.
---
 drivers/pci/p2pdma.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/pci/p2pdma.c b/drivers/pci/p2pdma.c
index ec53b2b0d..6eacb25a5 100644
--- a/drivers/pci/p2pdma.c
+++ b/drivers/pci/p2pdma.c
@@ -436,6 +436,8 @@ static const struct pci_p2pdma_whitelist_entry {
 	/* Intel Xeon E7 v3/Xeon E5 v3/Core i7 */
 	{PCI_VENDOR_ID_INTEL,	0x2f00, REQ_SAME_HOST_BRIDGE},
 	{PCI_VENDOR_ID_INTEL,	0x2f01, REQ_SAME_HOST_BRIDGE},
+	/* Intel Xeon E7 v4/Xeon E5 v4 */
+	{PCI_VENDOR_ID_INTEL,	0x6f00, REQ_SAME_HOST_BRIDGE},
 	/* Intel Skylake-E */
 	{PCI_VENDOR_ID_INTEL,	0x2030, 0},
 	{PCI_VENDOR_ID_INTEL,	0x2031, 0},
-- 
